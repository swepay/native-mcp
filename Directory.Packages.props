<Project>

  <!--
    Central Package Management (CPM) skeleton.

    ManagePackageVersionsCentrally is OFF (see Directory.Build.props) to mirror the
    NativeMediator repo: csproj files declare versions inline. This file is an inert,
    authoritative list of approved versions. Add new packages here FIRST.
  -->

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- === AWS Lambda === -->
  <ItemGroup>
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.1.0" />
    <PackageVersion Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.0" />
    <PackageVersion Include="Amazon.Lambda.RuntimeSupport" Version="2.1.1" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.0" />
  </ItemGroup>

  <!-- === Microsoft.Extensions === -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <!-- === Roslyn (source generators, analyzers) === -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
  </ItemGroup>

  <!-- === Swepay libs cross-reference === -->
  <ItemGroup>
    <PackageVersion Include="Native.FluentValidation" Version="1.0.1" />
    <PackageVersion Include="NativeLambdaRouter" Version="2.2.0" />
  </ItemGroup>

  <!-- === Test stack === -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="FluentAssertions" Version="7.1.0" />
  </ItemGroup>

  <!-- === Snapshot / Golden file testing === -->
  <ItemGroup>
    <PackageVersion Include="Verify.Xunit" Version="28.3.2" />
    <PackageVersion Include="Verify.SourceGenerators" Version="2.4.0" />
  </ItemGroup>

  <!-- === Tooling === -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>

</Project>
