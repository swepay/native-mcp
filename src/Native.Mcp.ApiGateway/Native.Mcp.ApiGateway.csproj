<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>Native.Mcp.ApiGateway</PackageId>
    <Version>2.1.0</Version>
    <Authors>Swepay</Authors>
    <Description>API Gateway HTTP API v2 transport for Native.Mcp: adapts the proxy event into the MCP dispatcher and back, for Lambdas that front MCP directly (without NativeLambdaRouter).</Description>
    <PackageTags>mcp;model-context-protocol;native-aot;serverless;lambda;api-gateway</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>native-mcp-c.png</PackageIcon>
    <RepositoryUrl>https://github.com/swepay/native-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" Version="3.0.0" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Native.Mcp\Native.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\native-mcp-c.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
