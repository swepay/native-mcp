<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>Native.Mcp.NativeLambdaRouter</PackageId>
    <Version>2.1.0</Version>
    <Authors>Swepay</Authors>
    <Description>Hosts a Native.Mcp server inside NativeLambdaRouter: maps a single POST /mcp route to the MCP JSON-RPC dispatcher, reusing the router's routing, claims extraction and Lambda entry point. The recommended way to run an MCP server in the Swepay Native ecosystem.</Description>
    <PackageTags>mcp;model-context-protocol;native-aot;serverless;lambda;native-lambda-router</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>native-mcp-c.png</PackageIcon>
    <RepositoryUrl>https://github.com/swepay/native-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.APIGatewayEvents" VersionOverride="3.0.1" />
    <PackageReference Include="Amazon.Lambda.Core" VersionOverride="3.3.0" />
    <PackageReference Include="NativeLambdaRouter" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Native.Mcp\Native.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\native-mcp-c.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
