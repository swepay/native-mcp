<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Analyzer/source-generator package: ships the generator under analyzers/dotnet/cs with no
         lib/ (IncludeBuildOutput=false). NU5128 (no lib for the declared TFM) is expected for
         analyzer packages and suppressed; the package still carries content (the analyzer dll). -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!-- Trim analyzer is only meaningful on the modern TFMs; disable on netstandard2.0. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsTrimmable>false</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>Native.Mcp.SourceGenerator</PackageId>
    <Version>1.0.0</Version>
    <Authors>Swepay</Authors>
    <Description>Roslyn source generator for Native.Mcp: emits JSON Schema (Draft 2020-12) inputSchema for each IMcpTool input type. Reflection-free, Native AOT compatible.</Description>
    <PackageTags>mcp;source-generator;roslyn;json-schema;native-aot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/swepay/native-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0-2.25625.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
