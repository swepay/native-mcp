<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Test infrastructure: intentionally reflection-based, exempt from AOT/trim analysis. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsAotCompatible>false</IsAotCompatible>

    <!-- Package metadata -->
    <PackageId>Native.Mcp.Testing</PackageId>
    <Version>2.1.0</Version>
    <Authors>Swepay</Authors>
    <Description>Test helpers for Native.Mcp: in-memory MCP host, JSON-RPC test client, fluent builders, and Shouldly assertion helpers for the canonical Swepay envelope.</Description>
    <PackageTags>mcp;testing;xunit;shouldly</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>native-mcp-c.png</PackageIcon>
    <RepositoryUrl>https://github.com/swepay/native-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Native.Mcp\Native.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\native-mcp-c.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
